              {
                "accountIds": [
                  8684376
                ],
                "query": "SELECT percentile(duration.ms, 95) FROM Span WHERE span.kind = 'server' FACET service.name TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Erros por serviço e rota",
          "layout": {
            "column": 7,
            "row": 7,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8684376
                ],
                "query": "SELECT count(*) AS 'Erros' FROM Span WHERE otel.status_code = 'ERROR' AND span.kind = 'server' FACET service.name AS 'Serviço', name AS 'Rota', error.group.message AS 'Erro' LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Últimos spans com erro (copie o trace.id para abrir o trace)",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 12,
            "height": 4
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8684376
                ],
                "query": "SELECT trace.id, service.name, name, error.group.message, duration.ms, toggle.flag_name FROM Span WHERE otel.status_code = 'ERROR' AND span.kind = 'server' LIMIT 50"
              }
            ]
          }
        }
