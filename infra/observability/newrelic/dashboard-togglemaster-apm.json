{
  "name": "ToggleMaster - APM",
  "description": "Traces OpenTelemetry dos 5 microsserviços (app -> OTel Collector -> New Relic).",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Visão geral",
      "description": null,
      "widgets": [
        {
          "title": "Requisições (spans de servidor)",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8684376
                ],
                "query": "SELECT count(*) AS 'Requisições' FROM Span WHERE span.kind = 'server'"
              }
            ]
          }
        },
        {
          "title": "Taxa de erro (%)",
          "layout": {
            "column": 4,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8684376
                ],
                "query": "SELECT percentage(count(*), WHERE otel.status_code = 'ERROR') AS 'Erro %' FROM Span WHERE span.kind = 'server'"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 1
              },
              {
                "alertSeverity": "CRITICAL",
                "value": 5
              }
            ]
          }
        },
        {
          "title": "Latência p95 do /evaluate (ms)",
          "layout": {
            "column": 7,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8684376
                ],
                "query": "SELECT percentile(duration.ms, 95) AS 'p95 (ms)' FROM Span WHERE service.name = 'evaluation-service' AND span.kind = 'server'"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 500
              },
              {
                "alertSeverity": "CRITICAL",
                "value": 1000
              }
            ]
          }
        },
        {
          "title": "Throughput (req/min)",
          "layout": {
            "column": 10,
            "row": 1,
            "width": 3,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8684376
                ],
                "query": "SELECT rate(count(*), 1 minute) AS 'req/min' FROM Span WHERE span.kind = 'server'"
              }
            ]
          }
        },
        {
          "title": "Taxa de erro por serviço (%)",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 6,
            "height": 3
          },
          "linkedEntityGuids": null,
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  8684376
                ],
                "query": "SELECT percentage(count(*), WHERE otel.status_code = 'ERROR') FROM Span WHERE span.kind = 'server' FACET service.name TIMESERIES AUTO"
              }
            ]
          }
        },
        {
          "title": "Throughput por serviço (req/min)",
          "layout": {
            "column": 7,
            "row": 4,
            "width": 6,
            "height": 3
